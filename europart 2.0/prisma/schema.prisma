// EUROPART 2.0 — stage 2 catalog schema.
// Accounts, carts, orders and B2B organizations stay out of this migration.
// Better Auth owns user tables in stage 4. Creating them now would collide with it.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ProductCondition {
  NEW
  USED
}

enum ProductKind {
  ORIGINAL
  ANALOG
}

enum ProductStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum IdentifierType {
  OEM
  ARTICLE
  CROSS_REFERENCE
}

enum OfferSourceType {
  OWN_STOCK
  SUPPLIER
}

enum OfferAvailability {
  IN_STOCK
  LOW_STOCK
  ON_ORDER
  INCOMING
  OUT_OF_STOCK
  DISCONTINUED
  UNKNOWN
}

enum WarehouseType {
  OWN
  SUPPLIER
}

enum CompatibilitySource {
  MANUAL
  SUPPLIER_FEED
  TECDOC
  VIN_CONFIRMED
}

enum CompatibilityConfidence {
  UNVERIFIED
  PROBABLE
  VERIFIED
}

enum VinRequestStatus {
  NEW
  IN_PROGRESS
  ANSWERED
  CLOSED
  CANCELLED
}

enum SeoEntityType {
  CATEGORY
  VEHICLE_BRAND
  VEHICLE_MODEL
  PRODUCT
  PART_BRAND
}

model Category {
  id          String     @id @default(uuid()) @db.Uuid
  name        String
  slug        String     @unique
  description String?
  parentId    String?    @db.Uuid
  parent      Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children    Category[] @relation("CategoryTree")
  image       String?
  sortOrder   Int        @default(0)
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime   @updatedAt @db.Timestamptz(3)
  products    Product[]

  @@index([parentId])
  @@index([isActive, sortOrder])
}

model VehicleBrand {
  id          String         @id @default(uuid()) @db.Uuid
  name        String
  slug        String         @unique
  logo        String?
  description String?
  isActive    Boolean        @default(true)
  sortOrder   Int            @default(0)
  createdAt   DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime       @updatedAt @db.Timestamptz(3)
  models      VehicleModel[]

  @@index([isActive, sortOrder])
}

model VehicleModel {
  id            String                @id @default(uuid()) @db.Uuid
  brandId       String                @db.Uuid
  brand         VehicleBrand          @relation(fields: [brandId], references: [id], onDelete: Restrict)
  name          String
  slug          String
  generation    String?
  startYear     Int?
  endYear       Int?
  isActive      Boolean               @default(true)
  createdAt     DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime              @updatedAt @db.Timestamptz(3)
  modifications VehicleModification[]

  @@unique([brandId, slug])
  @@index([brandId, isActive])
}

model VehicleModification {
  id              String                 @id @default(uuid()) @db.Uuid
  modelId         String                 @db.Uuid
  model           VehicleModel           @relation(fields: [modelId], references: [id], onDelete: Restrict)
  name            String
  yearFrom        Int?
  yearTo          Int?
  engine          String?
  engineCode      String?
  fuelType        String?
  displacement    Decimal?               @db.Decimal(4, 2)
  power           Int?
  bodyType        String?
  transmission    String?
  driveType       String?
  createdAt       DateTime               @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime               @updatedAt @db.Timestamptz(3)
  compatibilities ProductCompatibility[]

  @@index([modelId])
  @@index([engineCode])
}

model PartBrand {
  id          String              @id @default(uuid()) @db.Uuid
  name        String
  slug        String              @unique
  logo        String?
  country     String?
  description String?
  isActive    Boolean             @default(true)
  createdAt   DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime            @updatedAt @db.Timestamptz(3)
  products    Product[]
  identifiers ProductIdentifier[]

  @@index([isActive])
}

model Product {
  id                 String                 @id @default(uuid()) @db.Uuid
  name               String
  slug               String                 @unique
  description        String?
  categoryId         String                 @db.Uuid
  category           Category               @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  partBrandId        String?                @db.Uuid
  partBrand          PartBrand?             @relation(fields: [partBrandId], references: [id], onDelete: Restrict)
  article            String?
  articleNormalized  String?
  oem                String?
  condition          ProductCondition
  productType        ProductKind
  status             ProductStatus          @default(DRAFT)
  weight             Decimal?               @db.Decimal(10, 3)
  createdAt          DateTime               @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime               @updatedAt @db.Timestamptz(3)
  identifiers        ProductIdentifier[]
  images             ProductImage[]
  compatibilities    ProductCompatibility[]
  offers             ProductOffer[]

  @@index([categoryId, status])
  @@index([partBrandId])
  @@index([articleNormalized])
  @@index([status])
}

model ProductIdentifier {
  id              String         @id @default(uuid()) @db.Uuid
  productId       String         @db.Uuid
  product         Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  value           String
  normalizedValue String
  type            IdentifierType
  brandId         String?        @db.Uuid
  brand           PartBrand?     @relation(fields: [brandId], references: [id], onDelete: SetNull)
  isPrimary       Boolean        @default(false)
  createdAt       DateTime       @default(now()) @db.Timestamptz(3)

  @@unique([productId, type, normalizedValue])
  @@index([normalizedValue])
  @@index([type, normalizedValue])
}

model ProductImage {
  id        String   @id @default(uuid()) @db.Uuid
  productId String   @db.Uuid
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  alt       String?
  sortOrder Int      @default(0)

  @@index([productId, sortOrder])
}

model ProductCompatibility {
  id                    String                   @id @default(uuid()) @db.Uuid
  productId             String                   @db.Uuid
  product               Product                  @relation(fields: [productId], references: [id], onDelete: Cascade)
  vehicleModificationId String                   @db.Uuid
  vehicleModification   VehicleModification      @relation(fields: [vehicleModificationId], references: [id], onDelete: Restrict)
  compatibilitySource   CompatibilitySource
  confidence            CompatibilityConfidence  @default(UNVERIFIED)
  note                  String?
  verifiedAt            DateTime?                @db.Timestamptz(3)
  createdAt             DateTime                 @default(now()) @db.Timestamptz(3)

  @@unique([productId, vehicleModificationId])
  @@index([vehicleModificationId, confidence])
  @@index([productId, confidence])
}

model Supplier {
  id         String         @id @default(uuid()) @db.Uuid
  name       String
  code       String         @unique
  isActive   Boolean        @default(true)
  createdAt  DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime       @updatedAt @db.Timestamptz(3)
  warehouses Warehouse[]
  offers     ProductOffer[]
}

model Warehouse {
  id         String         @id @default(uuid()) @db.Uuid
  name       String
  code       String         @unique
  type       WarehouseType
  supplierId String?        @db.Uuid
  supplier   Supplier?      @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  city       String?
  createdAt  DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime       @updatedAt @db.Timestamptz(3)
  offers     ProductOffer[]

  @@index([supplierId])
}

model ProductOffer {
  id                 String            @id @default(uuid()) @db.Uuid
  productId          String            @db.Uuid
  product            Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  sourceType         OfferSourceType
  supplierId         String?           @db.Uuid
  supplier           Supplier?         @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  warehouseId        String?           @db.Uuid
  warehouse          Warehouse?        @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  purchasePrice      Decimal?          @db.Decimal(12, 2)
  retailPrice        Decimal?          @db.Decimal(12, 2)
  b2bPrice           Decimal?          @db.Decimal(12, 2)
  currency           String            @default("BYN") @db.Char(3)
  quantity           Int               @default(0)
  reservedQuantity   Int               @default(0)
  availabilityStatus OfferAvailability @default(UNKNOWN)
  leadTime           Int?
  updatedAt          DateTime          @updatedAt @db.Timestamptz(3)
  createdAt          DateTime          @default(now()) @db.Timestamptz(3)

  @@index([productId, availabilityStatus])
  @@index([supplierId])
  @@index([warehouseId])
}

model VinRequest {
  id             String           @id @default(uuid()) @db.Uuid
  vin            String
  vinIsStandard  Boolean
  vehicleBrand   String?
  vehicleModel   String?
  vehicleYear    Int?
  engine         String?
  partName       String?
  partNumber     String?
  customerName   String
  phone          String?
  email          String?
  comment        String?
  consentAccepted Boolean
  consentAt      DateTime         @db.Timestamptz(3)
  ip             String?
  status         VinRequestStatus @default(NEW)
  createdAt      DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime         @updatedAt @db.Timestamptz(3)

  @@index([status, createdAt])
  @@index([vin])
}

model SeoMetadata {
  id            String        @id @default(uuid()) @db.Uuid
  entityType    SeoEntityType
  entityId      String        @db.Uuid
  title         String?
  description   String?
  h1            String?
  canonicalPath String?
  updatedAt     DateTime      @updatedAt @db.Timestamptz(3)

  @@unique([entityType, entityId])
}
