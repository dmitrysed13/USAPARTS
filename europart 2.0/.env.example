# Local defaults match docker-compose.yml. Do not use these values in production.

DATABASE_URL="postgresql://europart:europart@localhost:5432/europart?schema=public"
REDIS_URL="redis://localhost:6379"

# Public site origin. Required in production. No trailing slash.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Better Auth is planned for stage 4. Do not invent a secret in the repository.
# Generate one locally when authentication is implemented:
# BETTER_AUTH_SECRET=
# BETTER_AUTH_URL="http://localhost:3000"
