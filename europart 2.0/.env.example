# Local defaults match docker-compose.yml. Do not use these values in production.

DATABASE_URL="postgresql://europart:europart@localhost:5432/europart?schema=public"
REDIS_URL="redis://localhost:6379"

# Public site origin. Required in production. No trailing slash.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Better Auth is planned for a later stage. Do not invent a secret in the repository.
# BETTER_AUTH_SECRET=
# BETTER_AUTH_URL="http://localhost:3000"

# Temporary admin gate until named accounts exist. At least 12 characters.
# Leave empty to keep /admin locked. Do not commit a real password.
# ADMIN_PASSWORD=
