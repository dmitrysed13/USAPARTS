# Public site origin, no path and no trailing slash.
# Production build refuses to run without a real https origin.
VITE_SITE_URL=

# Inbox that receives lead mail. SMTP password stays only on the server.
LEAD_TO=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Automatic Telegram delivery. Without the token the form opens https://t.me/dmitry_spa with the lead text.
# A private chat receives bot messages only after that account presses Start. Then put the numeric chat id here.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=@dmitry_spa

# Set to 1 only behind the reverse proxy that overwrites X-Forwarded-For.
TRUST_PROXY=
PORT=8787
