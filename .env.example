DATABASE_URL="postgresql://usaparts:usaparts@localhost:5432/usaparts"
REDIS_URL="redis://127.0.0.1:6379"
AUTH_SECRET="replace-with-a-long-random-string"
AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# External VIN decoder. Leave empty until a contract is signed.
# The adapter sends GET {VIN_DECODER_URL}/{vin} with header Authorization: Bearer {VIN_DECODER_API_KEY}
VIN_DECODER_URL=""
VIN_DECODER_API_KEY=""

# Payment provider code. Empty means online payment is not connected.
PAYMENT_PROVIDER=""
PAYMENT_SECRET=""

# Delivery carrier code. Empty means carrier quotes are not connected.
DELIVERY_PROVIDER=""
DELIVERY_API_KEY=""
