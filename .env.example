# Public site origin, no path and no trailing slash.
# Production build refuses to run without a real https origin.
VITE_SITE_URL=

# Inbox that receives lead mail. SMTP password stays only on the server.
LEAD_TO=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Optional Telegram notification. Both values are required, otherwise it stays off.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Set to 1 only behind the reverse proxy that overwrites X-Forwarded-For.
TRUST_PROXY=
PORT=8787
