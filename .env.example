# Public site origin, no path and no trailing slash.
# Production build refuses to run without a real https origin.
VITE_SITE_URL=

# Inbox for lead mail. Defaults to dmitry.chanoff@gmail.com when these are empty.
# SMTP_PASS is a Gmail app password and stays only on the server.
LEAD_TO=dmitry.chanoff@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=dmitry.chanoff@gmail.com
SMTP_PASS=
SMTP_FROM=dmitry.chanoff@gmail.com

# Optional copy of the same lead in Telegram. Mail remains the required channel when SMTP_PASS is set.
# A private chat receives bot messages only after that account presses Start. Then put the numeric chat id here.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=@dmitry_spa

# Set to 1 only behind the reverse proxy that overwrites X-Forwarded-For.
TRUST_PROXY=
PORT=8787
