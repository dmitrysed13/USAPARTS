  "dependencies": {
    "@fontsource/manrope": "^5.3.0",
    "@fontsource/oswald": "^5.3.0",
    "lucide-react": "^1.66.0",
    "nodemailer": "^7.0.13",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
