# Local defaults match docker-compose.yml. Do not use these values in production.

DATABASE_URL="postgresql://europart:europart@localhost:5432/europart?schema=public"
REDIS_URL="redis://localhost:6379"

# Public site origin. Required in production. No trailing slash.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Better Auth is planned for stage 4. Do not invent a secret in the repository.
# Generate one locally when authentication is implemented:
# BETTER_AUTH_SECRET=
# BETTER_AUTH_URL="http://localhost:3000"

# Admin-ready APIs (§5). Min 16 chars. Never commit a real value.
# ADMIN_API_TOKEN=

# Admin panel (§7). Session HMAC (falls back to ADMIN_API_TOKEN if unset).
# ADMIN_SESSION_SECRET=
# First Super Admin when StaffUser table is empty (password ≥ 12 chars):
# ADMIN_BOOTSTRAP_EMAIL=
# ADMIN_BOOTSTRAP_PASSWORD=

# Cart cookie HMAC (§6). Min 16 chars. Falls back to BETTER_AUTH_SECRET if set.
# CART_SECRET=

# Payments (§6). Online checkout stays unavailable until both are set.
# PAYMENT_PROVIDER=
# PAYMENT_WEBHOOK_SECRET=

# Notifications (§6). Without these, channels fail closed (order still saves).
# SMTP_HOST=
# SMTP_FROM=
# MANAGER_EMAIL=
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# SEO engine (§8). Public indexing needs BOTH this env AND admin SeoSettings.indexingEnabled.
# SEO_INDEXING_ENABLED=false
# Canonical host for prod: https://europart.by (no DNS changes from the app).
# NEXT_PUBLIC_SITE_URL="https://europart.by"
# Analytics / webmaster IDs (optional; env overrides admin SeoSettings):
# GA4_MEASUREMENT_ID=
# GSC_VERIFICATION=
# YANDEX_METRIKA_ID=
# YANDEX_WEBMASTER_VERIFICATION=
# GOOGLE_MERCHANT_ID=
