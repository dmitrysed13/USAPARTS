// EUROPART 3.0 — catalog + commerce draft schema.
// Hierarchy: Make → Model → Generation → Modification → Category → Product.
// Auth/session tables stay out until identity stage (Better Auth owns them).
// No seed catalog data: empty DB is a valid public state.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ProductCondition {
  NEW
  USED
}

enum ProductKind {
  ORIGINAL
  ANALOG
}

enum ProductStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum IdentifierType {
  OEM
  ARTICLE
  CROSS_REFERENCE
  ANALOG
}

enum OfferSourceType {
  OWN_STOCK
  SUPPLIER
}

enum OfferAvailability {
  IN_STOCK
  LOW_STOCK
  ON_ORDER
  INCOMING
  OUT_OF_STOCK
  DISCONTINUED
  UNKNOWN
}

enum WarehouseType {
  OWN
  SUPPLIER
}

enum CompatibilitySource {
  MANUAL
  SUPPLIER_FEED
  TECDOC
  VIN_CONFIRMED
}

enum CompatibilityConfidence {
  UNVERIFIED
  PROBABLE
  VERIFIED
}

enum VinRequestStatus {
  NEW
  IN_PROGRESS
  ANSWERED
  CLOSED
  CANCELLED
}

enum OrderStatus {
  NEW
  CONFIRMED
  PROCESSING
  SHIPPED
  COMPLETED
  CANCELLED
}

enum PaymentState {
  NOT_CONNECTED
  AWAITING
  PAID
  FAILED
  REFUNDED
}

enum LeadType {
  RARE_PART
  PRICE_REQUEST
  B2B
  CONTACT
}

enum LeadStatus {
  NEW
  IN_PROGRESS
  CLOSED
  CANCELLED
}

enum SeoEntityType {
  CATEGORY
  VEHICLE_BRAND
  VEHICLE_MODEL
  VEHICLE_GENERATION
  PRODUCT
  PART_BRAND
}

enum OfferStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum StockSourceKind {
  WAREHOUSE
  SUPPLIER
  ON_ORDER
}

enum SupplierImportFormat {
  CSV
  XLSX
  API
  MANUAL
}

enum MarkupScope {
  GLOBAL
  CATEGORY
  SUPPLIER
  PART_BRAND
}

enum MarkupType {
  PERCENT
  FIXED
}

enum ImportJobStatus {
  UPLOADED
  READY
  COMMITTED
  ROLLED_BACK
  FAILED
}

enum ImportRowAction {
  CREATE
  UPDATE
  ERROR
  DUPLICATE
}

enum SupplierSyncKind {
  PRODUCTS
  PRICES
  STOCK
  FULL
}

enum SupplierSyncStatus {
  STARTED
  SUCCESS
  PARTIAL
  FAILED
}

model Category {
  id          String     @id @default(uuid()) @db.Uuid
  name        String
  slug        String     @unique
  description String?
  parentId    String?    @db.Uuid
  parent      Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children    Category[] @relation("CategoryTree")
  image       String?
  sortOrder   Int        @default(0)
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime   @updatedAt @db.Timestamptz(3)
  products    Product[]

  @@index([parentId])
  @@index([isActive, sortOrder])
}

model VehicleBrand {
  id          String         @id @default(uuid()) @db.Uuid
  name        String
  slug        String         @unique
  logo        String?
  description String?
  isActive    Boolean        @default(true)
  sortOrder   Int            @default(0)
  createdAt   DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime       @updatedAt @db.Timestamptz(3)
  models      VehicleModel[]

  @@index([isActive, sortOrder])
}

model VehicleModel {
  id          String              @id @default(uuid()) @db.Uuid
  brandId     String              @db.Uuid
  brand       VehicleBrand        @relation(fields: [brandId], references: [id], onDelete: Restrict)
  name        String
  slug        String
  startYear   Int?
  endYear     Int?
  isActive    Boolean             @default(true)
  createdAt   DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime            @updatedAt @db.Timestamptz(3)
  generations VehicleGeneration[]

  @@unique([brandId, slug])
  @@index([brandId, isActive])
}

model VehicleGeneration {
  id            String                @id @default(uuid()) @db.Uuid
  modelId       String                @db.Uuid
  model         VehicleModel          @relation(fields: [modelId], references: [id], onDelete: Restrict)
  name          String
  slug          String
  startYear     Int?
  endYear       Int?
  isActive      Boolean               @default(true)
  createdAt     DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime              @updatedAt @db.Timestamptz(3)
  modifications VehicleModification[]

  @@unique([modelId, slug])
  @@index([modelId, isActive])
}

model VehicleModification {
  id              String                 @id @default(uuid()) @db.Uuid
  generationId    String                 @db.Uuid
  generation      VehicleGeneration      @relation(fields: [generationId], references: [id], onDelete: Restrict)
  name            String
  slug            String?
  yearFrom        Int?
  yearTo          Int?
  engine          String?
  engineCode      String?
  fuelType        String?
  displacement    Decimal?               @db.Decimal(4, 2)
  power           Int?
  bodyType        String?
  transmission    String?
  driveType       String?
  createdAt       DateTime               @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime               @updatedAt @db.Timestamptz(3)
  compatibilities ProductCompatibility[]

  @@index([generationId])
  @@index([engineCode])
}

model PartBrand {
  id          String              @id @default(uuid()) @db.Uuid
  name        String
  slug        String              @unique
  logo        String?
  country     String?
  description String?
  isActive    Boolean             @default(true)
  createdAt   DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime            @updatedAt @db.Timestamptz(3)
  products    Product[]
  identifiers ProductIdentifier[]

  @@index([isActive])
}

model Product {
  id                String                 @id @default(uuid()) @db.Uuid
  name              String
  slug              String                 @unique
  description       String?
  categoryId        String                 @db.Uuid
  category          Category               @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  partBrandId       String?                @db.Uuid
  partBrand         PartBrand?             @relation(fields: [partBrandId], references: [id], onDelete: Restrict)
  article           String?
  articleNormalized String?
  /// Manufacturer part number when distinct from supplier article / OEM.
  mpn               String?
  oem               String?
  condition         ProductCondition
  productType       ProductKind
  status            ProductStatus          @default(DRAFT)
  weight            Decimal?               @db.Decimal(10, 3)
  createdAt         DateTime               @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime               @updatedAt @db.Timestamptz(3)
  identifiers       ProductIdentifier[]
  images            ProductImage[]
  attributes        ProductAttribute[]
  compatibilities   ProductCompatibility[]
  offers            ProductOffer[]
  orderItems        OrderItem[]

  @@index([categoryId, status])
  @@index([partBrandId])
  @@index([articleNormalized])
  @@index([mpn])
  @@index([status])
}

model ProductAttribute {
  id        String   @id @default(uuid()) @db.Uuid
  productId String   @db.Uuid
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  key       String
  value     String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@unique([productId, key])
  @@index([productId, sortOrder])
}

model ProductIdentifier {
  id              String         @id @default(uuid()) @db.Uuid
  productId       String         @db.Uuid
  product         Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  value           String
  normalizedValue String
  type            IdentifierType
  brandId         String?        @db.Uuid
  brand           PartBrand?     @relation(fields: [brandId], references: [id], onDelete: SetNull)
  isPrimary       Boolean        @default(false)
  createdAt       DateTime       @default(now()) @db.Timestamptz(3)

  @@unique([productId, type, normalizedValue])
  @@index([normalizedValue])
  @@index([type, normalizedValue])
}

model ProductImage {
  id        String   @id @default(uuid()) @db.Uuid
  productId String   @db.Uuid
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  alt       String?
  sortOrder Int      @default(0)

  @@index([productId, sortOrder])
}

model ProductCompatibility {
  id                    String                  @id @default(uuid()) @db.Uuid
  productId             String                  @db.Uuid
  product               Product                 @relation(fields: [productId], references: [id], onDelete: Cascade)
  vehicleModificationId String                  @db.Uuid
  vehicleModification   VehicleModification     @relation(fields: [vehicleModificationId], references: [id], onDelete: Restrict)
  compatibilitySource   CompatibilitySource
  confidence            CompatibilityConfidence @default(UNVERIFIED)
  note                  String?
  verifiedAt            DateTime?               @db.Timestamptz(3)
  createdAt             DateTime                @default(now()) @db.Timestamptz(3)

  @@unique([productId, vehicleModificationId])
  @@index([vehicleModificationId, confidence])
  @@index([productId, confidence])
}

/// Supplier of assortment / prices. One Product may have many ProductOffer rows (supplier offers).
model Supplier {
  id                String               @id @default(uuid()) @db.Uuid
  name              String
  code              String               @unique
  email             String?
  phone             String?
  website           String?
  note              String?
  terms             String?
  currency          String               @default("EUR") @db.Char(3)
  importFormat      SupplierImportFormat @default(MANUAL)
  apiEnabled        Boolean              @default(false)
  apiBaseUrl        String?
  credentialsEnvKey String?
  isActive          Boolean              @default(true)
  createdAt         DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime             @updatedAt @db.Timestamptz(3)
  warehouses        Warehouse[]
  offers            ProductOffer[]
  importTemplates   ImportTemplate[]
  importJobs        ImportJob[]
  syncLogs          SupplierSyncLog[]
  markupRules       MarkupRule[]
}

model Warehouse {
  id             String         @id @default(uuid()) @db.Uuid
  name           String
  code           String         @unique
  type           WarehouseType
  supplierId     String?        @db.Uuid
  supplier       Supplier?      @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  city           String?
  address        String?
  isActive       Boolean        @default(true)
  stockUpdatedAt DateTime?      @db.Timestamptz(3)
  createdAt      DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime       @updatedAt @db.Timestamptz(3)
  offers         ProductOffer[]
  importJobs     ImportJob[]

  @@index([supplierId])
  @@index([isActive, type])
}

/// Supplier / warehouse offer for a product. Public catalog never exposes purchase cost or supplier id.
model ProductOffer {
  id                 String            @id @default(uuid()) @db.Uuid
  productId          String            @db.Uuid
  product            Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  sourceType         OfferSourceType
  supplierId         String?           @db.Uuid
  supplier           Supplier?         @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  warehouseId        String?           @db.Uuid
  warehouse          Warehouse?        @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  /// External SKU / offer id at the supplier feed.
  externalId         String?
  condition          ProductCondition  @default(NEW)
  status             OfferStatus       @default(ACTIVE)
  purchasePrice      Decimal?          @db.Decimal(12, 2)
  /// Currency of purchasePrice before FX conversion to BYN retail.
  purchaseCurrency   String?           @db.Char(3)
  retailPrice        Decimal?          @db.Decimal(12, 2)
  b2bPrice           Decimal?          @db.Decimal(12, 2)
  extrasAmount       Decimal?          @db.Decimal(12, 2)
  /// Display / settlement currency for retail and b2b (always BYN on storefront).
  currency           String            @default("BYN") @db.Char(3)
  quantity           Int               @default(0)
  reservedQuantity   Int               @default(0)
  availabilityStatus OfferAvailability @default(UNKNOWN)
  stockSource        StockSourceKind?
  /// Only confirmed stock may appear as in-stock on the storefront.
  stockConfirmed     Boolean           @default(false)
  stockUpdatedAt     DateTime?         @db.Timestamptz(3)
  leadTime           Int?
  updatedAt          DateTime          @updatedAt @db.Timestamptz(3)
  createdAt          DateTime          @default(now()) @db.Timestamptz(3)
  priceHistory       OfferPriceHistory[]

  @@index([productId, availabilityStatus])
  @@index([productId, status])
  @@index([supplierId])
  @@index([warehouseId])
  @@index([supplierId, externalId])
  @@index([stockConfirmed, availabilityStatus])
}

model OfferPriceHistory {
  id               String   @id @default(uuid()) @db.Uuid
  offerId          String   @db.Uuid
  offer            ProductOffer @relation(fields: [offerId], references: [id], onDelete: Cascade)
  purchasePrice    Decimal? @db.Decimal(12, 2)
  purchaseCurrency String?  @db.Char(3)
  fxRate           Decimal? @db.Decimal(18, 8)
  markupType       MarkupType?
  markupValue      Decimal? @db.Decimal(12, 4)
  extrasAmount     Decimal? @db.Decimal(12, 2)
  retailPrice      Decimal? @db.Decimal(12, 2)
  b2bPrice         Decimal? @db.Decimal(12, 2)
  currency         String   @default("BYN") @db.Char(3)
  source           String
  note             String?
  createdAt        DateTime @default(now()) @db.Timestamptz(3)

  @@index([offerId, createdAt])
}

/// Manual FX rates only — no automatic FX without a configured rate/source.
model FxRate {
  id            String   @id @default(uuid()) @db.Uuid
  baseCurrency  String   @db.Char(3)
  quoteCurrency String   @db.Char(3)
  rate          Decimal  @db.Decimal(18, 8)
  source        String
  effectiveFrom DateTime @db.Timestamptz(3)
  effectiveTo   DateTime? @db.Timestamptz(3)
  createdAt     DateTime @default(now()) @db.Timestamptz(3)

  @@index([baseCurrency, quoteCurrency, effectiveFrom])
}

model MarkupRule {
  id          String      @id @default(uuid()) @db.Uuid
  name        String
  scope       MarkupScope
  categoryId  String?     @db.Uuid
  supplierId  String?     @db.Uuid
  supplier    Supplier?   @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  partBrandId String?     @db.Uuid
  markupType  MarkupType
  value       Decimal     @db.Decimal(12, 4)
  b2bValue    Decimal?    @db.Decimal(12, 4)
  priority    Int         @default(100)
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime    @updatedAt @db.Timestamptz(3)

  @@index([scope, isActive, priority])
  @@index([categoryId])
  @@index([supplierId])
  @@index([partBrandId])
}

model ImportTemplate {
  id         String      @id @default(uuid()) @db.Uuid
  supplierId String      @db.Uuid
  supplier   Supplier    @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  name       String
  mapping    Json
  options    Json
  createdAt  DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime    @updatedAt @db.Timestamptz(3)
  jobs       ImportJob[]

  @@unique([supplierId, name])
  @@index([supplierId])
}

model ImportJob {
  id          String          @id @default(uuid()) @db.Uuid
  supplierId  String?         @db.Uuid
  supplier    Supplier?       @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  warehouseId String?         @db.Uuid
  warehouse   Warehouse?      @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  templateId  String?         @db.Uuid
  template    ImportTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  sourceType  OfferSourceType
  filename    String
  status      ImportJobStatus @default(UPLOADED)
  headers     Json
  rawRows     Json
  mapping     Json?
  summary     Json?
  createdAt   DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime        @updatedAt @db.Timestamptz(3)
  rows        ImportRow[]

  @@index([status, createdAt])
  @@index([supplierId])
}

model ImportRow {
  id         String          @id @default(uuid()) @db.Uuid
  jobId      String          @db.Uuid
  job        ImportJob       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  rowNumber  Int
  normalized Json
  action     ImportRowAction
  message    String?
  productId  String?         @db.Uuid
  offerId    String?         @db.Uuid
  snapshot   Json?
  applied    Boolean         @default(false)

  @@unique([jobId, rowNumber])
  @@index([jobId, action])
}

model SupplierSyncLog {
  id           String             @id @default(uuid()) @db.Uuid
  supplierId   String             @db.Uuid
  supplier     Supplier           @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  kind         SupplierSyncKind
  status       SupplierSyncStatus
  attempt      Int                @default(1)
  itemsRead    Int                @default(0)
  itemsWritten Int                @default(0)
  errorMessage String?
  detail       Json?
  startedAt    DateTime           @default(now()) @db.Timestamptz(3)
  finishedAt   DateTime?          @db.Timestamptz(3)

  @@index([supplierId, startedAt])
  @@index([status, startedAt])
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actor      String
  action     String
  entityType String
  entityId   String
  summary    String
  changes    Json?
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  @@index([createdAt])
  @@index([entityType, entityId])
}

model VinRequest {
  id              String           @id @default(uuid()) @db.Uuid
  vin             String
  vinIsStandard   Boolean
  vehicleBrand    String?
  vehicleModel    String?
  vehicleYear     Int?
  engine          String?
  partName        String?
  partNumber      String?
  customerName    String
  phone           String?
  email           String?
  comment         String?
  consentAccepted Boolean
  consentAt       DateTime         @db.Timestamptz(3)
  ip              String?
  status          VinRequestStatus @default(NEW)
  createdAt       DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime         @updatedAt @db.Timestamptz(3)

  @@index([status, createdAt])
  @@index([vin])
}

/// Guest/customer order draft for commerce stage. Checkout UI not wired yet.
model Order {
  id              String       @id @default(uuid()) @db.Uuid
  number          String       @unique
  accessToken     String       @unique
  status          OrderStatus  @default(NEW)
  paymentState    PaymentState @default(NOT_CONNECTED)
  customerName    String
  customerPhone   String?
  customerEmail   String?
  comment         String?
  deliveryMethod  String?
  deliveryAddress String?
  deliveryNote    String?
  subtotalCents   Int
  discountCents   Int          @default(0)
  deliveryCents   Int          @default(0)
  totalCents      Int
  currency        String       @default("BYN") @db.Char(3)
  createdAt       DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime     @updatedAt @db.Timestamptz(3)
  items           OrderItem[]

  @@index([status, createdAt])
}

model OrderItem {
  id             String  @id @default(uuid()) @db.Uuid
  orderId        String  @db.Uuid
  order          Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId      String? @db.Uuid
  product        Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  sku            String
  name           String
  unitPriceCents Int
  quantity       Int
  currency       String  @default("BYN") @db.Char(3)

  @@index([orderId])
  @@index([productId])
}

/// Leads for rare parts / price requests / B2B — SMTP + Telegram later.
model Lead {
  id        String     @id @default(uuid()) @db.Uuid
  type      LeadType
  status    LeadStatus @default(NEW)
  name      String
  phone     String?
  email     String?
  message   String?
  productId String?    @db.Uuid
  vin       String?
  article   String?
  ip        String?
  createdAt DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt DateTime   @updatedAt @db.Timestamptz(3)

  @@index([type, status, createdAt])
}

model SeoMetadata {
  id            String        @id @default(uuid()) @db.Uuid
  entityType    SeoEntityType
  entityId      String        @db.Uuid
  title         String?
  description   String?
  h1            String?
  canonicalPath String?
  updatedAt     DateTime      @updatedAt @db.Timestamptz(3)

  @@unique([entityType, entityId])
}
