// EUROPART 3.0 — catalog + commerce draft schema.
// Hierarchy: Make → Model → Generation → Modification → Category → Product.
// Auth/session tables stay out until identity stage (Better Auth owns them).
// No seed catalog data: empty DB is a valid public state.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ProductCondition {
  NEW
  USED
}

enum ProductKind {
  ORIGINAL
  ANALOG
}

enum ProductStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum IdentifierType {
  OEM
  ARTICLE
  CROSS_REFERENCE
  ANALOG
}

enum OfferSourceType {
  OWN_STOCK
  SUPPLIER
}

enum OfferAvailability {
  IN_STOCK
  LOW_STOCK
  ON_ORDER
  INCOMING
  OUT_OF_STOCK
  DISCONTINUED
  UNKNOWN
}

enum WarehouseType {
  OWN
  SUPPLIER
}

enum CompatibilitySource {
  MANUAL
  SUPPLIER_FEED
  TECDOC
  VIN_CONFIRMED
}

enum CompatibilityConfidence {
  UNVERIFIED
  PROBABLE
  VERIFIED
}

enum VinRequestStatus {
  NEW
  IN_PROGRESS
  ANSWERED
  CLOSED
  CANCELLED
}

enum OrderStatus {
  NEW
  UNDER_REVIEW
  AWAITING_CONFIRMATION
  CONFIRMED
  AWAITING_PAYMENT
  PAID
  PROCESSING
  ORDERED_FROM_SUPPLIER
  SHIPPED
  DELIVERED
  /// Legacy alias from foundation draft; prefer DELIVERED.
  COMPLETED
  CANCELLED
  RETURN
}

enum PaymentState {
  NOT_CONNECTED
  AWAITING
  PAID
  FAILED
  REFUNDED
}

enum CheckoutMode {
  MANAGER
  ONLINE
}

enum PaymentTransactionStatus {
  CREATED
  PENDING
  SUCCEEDED
  FAILED
  CANCELLED
  REFUNDED
}

enum LeadType {
  RARE_PART
  PRICE_REQUEST
  B2B
  CONTACT
}

enum LeadStatus {
  NEW
  IN_PROGRESS
  CLOSED
  CANCELLED
}

enum SeoEntityType {
  CATEGORY
  VEHICLE_BRAND
  VEHICLE_MODEL
  VEHICLE_GENERATION
  VEHICLE_MODIFICATION
  VEHICLE_ENGINE
  PRODUCT
  PART_BRAND
  /// CMS document (article / guide / FAQ / review / section content).
  CMS_DOCUMENT
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

/// Editorial content kinds. Empty CMS is OK — no auto-spam seed.
enum ContentKind {
  ARTICLE
  GUIDE
  FAQ
  REVIEW
  CATEGORY_CONTENT
  VEHICLE_CONTENT
}

enum SeoRobotsMode {
  AUTO
  INDEX
  NOINDEX
}

enum SemanticClusterIntent {
  COMMERCIAL_BROAD
  COMMERCIAL_MID
  COMMERCIAL_NARROW
  INFORMATIONAL
  GEO
  B2B
}

enum OfferStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum StockSourceKind {
  WAREHOUSE
  SUPPLIER
  ON_ORDER
}

enum SupplierImportFormat {
  CSV
  XLSX
  API
  MANUAL
}

enum MarkupScope {
  GLOBAL
  CATEGORY
  SUPPLIER
  PART_BRAND
}

enum MarkupType {
  PERCENT
  FIXED
}

enum ImportJobStatus {
  UPLOADED
  READY
  COMMITTED
  ROLLED_BACK
  FAILED
}

enum ImportRowAction {
  CREATE
  UPDATE
  ERROR
  DUPLICATE
}

enum SupplierSyncKind {
  PRODUCTS
  PRICES
  STOCK
  FULL
}

enum SupplierSyncStatus {
  STARTED
  SUCCESS
  PARTIAL
  FAILED
}

model Category {
  id          String     @id @default(uuid()) @db.Uuid
  name        String
  slug        String     @unique
  description String?
  parentId    String?    @db.Uuid
  parent      Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children    Category[] @relation("CategoryTree")
  image       String?
  sortOrder   Int        @default(0)
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime   @updatedAt @db.Timestamptz(3)
  products      Product[]
  cmsDocuments  CmsDocument[]

  @@index([parentId])
  @@index([isActive, sortOrder])
}

model VehicleBrand {
  id           String         @id @default(uuid()) @db.Uuid
  name         String
  slug         String         @unique
  logo         String?
  description  String?
  isActive     Boolean        @default(true)
  sortOrder    Int            @default(0)
  createdAt    DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime       @updatedAt @db.Timestamptz(3)
  models       VehicleModel[]
  cmsDocuments CmsDocument[]

  @@index([isActive, sortOrder])
}

model VehicleModel {
  id           String              @id @default(uuid()) @db.Uuid
  brandId      String              @db.Uuid
  brand        VehicleBrand        @relation(fields: [brandId], references: [id], onDelete: Restrict)
  name         String
  slug         String
  startYear    Int?
  endYear      Int?
  isActive     Boolean             @default(true)
  createdAt    DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime            @updatedAt @db.Timestamptz(3)
  generations  VehicleGeneration[]
  cmsDocuments CmsDocument[]

  @@unique([brandId, slug])
  @@index([brandId, isActive])
}

model VehicleGeneration {
  id            String                @id @default(uuid()) @db.Uuid
  modelId       String                @db.Uuid
  model         VehicleModel          @relation(fields: [modelId], references: [id], onDelete: Restrict)
  name          String
  slug          String
  startYear     Int?
  endYear       Int?
  isActive      Boolean               @default(true)
  createdAt     DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime              @updatedAt @db.Timestamptz(3)
  modifications VehicleModification[]

  @@unique([modelId, slug])
  @@index([modelId, isActive])
}

model VehicleModification {
  id              String                 @id @default(uuid()) @db.Uuid
  generationId    String                 @db.Uuid
  generation      VehicleGeneration      @relation(fields: [generationId], references: [id], onDelete: Restrict)
  name            String
  slug            String
  yearFrom        Int?
  yearTo          Int?
  /// Legacy denormalized engine label — prefer VehicleEngine rows when present.
  engine          String?
  engineCode      String?
  fuelType        String?
  displacement    Decimal?               @db.Decimal(4, 2)
  power           Int?
  bodyType        String?
  transmission    String?
  driveType       String?
  isActive        Boolean                @default(true)
  createdAt       DateTime               @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime               @updatedAt @db.Timestamptz(3)
  engines         VehicleEngine[]
  compatibilities ProductCompatibility[]

  @@unique([generationId, slug])
  @@index([generationId, isActive])
  @@index([engineCode])
}

/// Engine under a modification (Make→Model→Generation→Modification→Engine).
model VehicleEngine {
  id               String                 @id @default(uuid()) @db.Uuid
  modificationId   String                 @db.Uuid
  modification     VehicleModification    @relation(fields: [modificationId], references: [id], onDelete: Restrict)
  name             String
  slug             String
  code             String?
  fuelType         String?
  displacement     Decimal?               @db.Decimal(4, 2)
  power            Int?
  isActive         Boolean                @default(true)
  createdAt        DateTime               @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime               @updatedAt @db.Timestamptz(3)
  compatibilities  ProductCompatibility[]

  @@unique([modificationId, slug])
  @@index([modificationId, isActive])
  @@index([code])
}

model PartBrand {
  id          String              @id @default(uuid()) @db.Uuid
  name        String
  slug        String              @unique
  logo        String?
  country     String?
  description String?
  isActive    Boolean             @default(true)
  createdAt   DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime            @updatedAt @db.Timestamptz(3)
  products    Product[]
  identifiers ProductIdentifier[]

  @@index([isActive])
}

model Product {
  id                String                 @id @default(uuid()) @db.Uuid
  name              String
  slug              String                 @unique
  description       String?
  categoryId        String                 @db.Uuid
  category          Category               @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  partBrandId       String?                @db.Uuid
  partBrand         PartBrand?             @relation(fields: [partBrandId], references: [id], onDelete: Restrict)
  article           String?
  articleNormalized String?
  /// Manufacturer part number when distinct from supplier article / OEM.
  mpn               String?
  oem               String?
  condition         ProductCondition
  productType       ProductKind
  status            ProductStatus          @default(DRAFT)
  weight            Decimal?               @db.Decimal(10, 3)
  createdAt         DateTime               @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime               @updatedAt @db.Timestamptz(3)
  identifiers       ProductIdentifier[]
  images            ProductImage[]
  attributes        ProductAttribute[]
  compatibilities   ProductCompatibility[]
  offers            ProductOffer[]
  orderItems        OrderItem[]
  cmsLinks          CmsDocumentProduct[]

  @@index([categoryId, status])
  @@index([partBrandId])
  @@index([articleNormalized])
  @@index([mpn])
  @@index([status])
}

model ProductAttribute {
  id        String   @id @default(uuid()) @db.Uuid
  productId String   @db.Uuid
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  key       String
  value     String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@unique([productId, key])
  @@index([productId, sortOrder])
}

model ProductIdentifier {
  id              String         @id @default(uuid()) @db.Uuid
  productId       String         @db.Uuid
  product         Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  value           String
  normalizedValue String
  type            IdentifierType
  brandId         String?        @db.Uuid
  brand           PartBrand?     @relation(fields: [brandId], references: [id], onDelete: SetNull)
  isPrimary       Boolean        @default(false)
  createdAt       DateTime       @default(now()) @db.Timestamptz(3)

  @@unique([productId, type, normalizedValue])
  @@index([normalizedValue])
  @@index([type, normalizedValue])
}

model ProductImage {
  id        String   @id @default(uuid()) @db.Uuid
  productId String   @db.Uuid
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  alt       String?
  sortOrder Int      @default(0)

  @@index([productId, sortOrder])
}

model ProductCompatibility {
  id                    String                  @id @default(uuid()) @db.Uuid
  productId             String                  @db.Uuid
  product               Product                 @relation(fields: [productId], references: [id], onDelete: Cascade)
  vehicleModificationId String                  @db.Uuid
  vehicleModification   VehicleModification     @relation(fields: [vehicleModificationId], references: [id], onDelete: Restrict)
  /// Optional engine refinement under the modification.
  vehicleEngineId       String?                 @db.Uuid
  vehicleEngine         VehicleEngine?          @relation(fields: [vehicleEngineId], references: [id], onDelete: Restrict)
  compatibilitySource   CompatibilitySource
  confidence            CompatibilityConfidence @default(UNVERIFIED)
  note                  String?
  verifiedAt            DateTime?               @db.Timestamptz(3)
  createdAt             DateTime                @default(now()) @db.Timestamptz(3)

  @@unique([productId, vehicleModificationId])
  @@index([vehicleModificationId, confidence])
  @@index([vehicleEngineId, confidence])
  @@index([productId, confidence])
}

/// Supplier of assortment / prices. One Product may have many ProductOffer rows (supplier offers).
model Supplier {
  id                String               @id @default(uuid()) @db.Uuid
  name              String
  code              String               @unique
  email             String?
  phone             String?
  website           String?
  note              String?
  terms             String?
  currency          String               @default("EUR") @db.Char(3)
  importFormat      SupplierImportFormat @default(MANUAL)
  apiEnabled        Boolean              @default(false)
  apiBaseUrl        String?
  credentialsEnvKey String?
  isActive          Boolean              @default(true)
  createdAt         DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime             @updatedAt @db.Timestamptz(3)
  warehouses        Warehouse[]
  offers            ProductOffer[]
  importTemplates   ImportTemplate[]
  importJobs        ImportJob[]
  syncLogs          SupplierSyncLog[]
  markupRules       MarkupRule[]
}

model Warehouse {
  id             String         @id @default(uuid()) @db.Uuid
  name           String
  code           String         @unique
  type           WarehouseType
  supplierId     String?        @db.Uuid
  supplier       Supplier?      @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  city           String?
  address        String?
  isActive       Boolean        @default(true)
  stockUpdatedAt DateTime?      @db.Timestamptz(3)
  createdAt      DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime       @updatedAt @db.Timestamptz(3)
  offers         ProductOffer[]
  importJobs     ImportJob[]

  @@index([supplierId])
  @@index([isActive, type])
}

/// Supplier / warehouse offer for a product. Public catalog never exposes purchase cost or supplier id.
model ProductOffer {
  id                 String            @id @default(uuid()) @db.Uuid
  productId          String            @db.Uuid
  product            Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  sourceType         OfferSourceType
  supplierId         String?           @db.Uuid
  supplier           Supplier?         @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  warehouseId        String?           @db.Uuid
  warehouse          Warehouse?        @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  /// External SKU / offer id at the supplier feed.
  externalId         String?
  condition          ProductCondition  @default(NEW)
  status             OfferStatus       @default(ACTIVE)
  purchasePrice      Decimal?          @db.Decimal(12, 2)
  /// Currency of purchasePrice before FX conversion to BYN retail.
  purchaseCurrency   String?           @db.Char(3)
  retailPrice        Decimal?          @db.Decimal(12, 2)
  b2bPrice           Decimal?          @db.Decimal(12, 2)
  extrasAmount       Decimal?          @db.Decimal(12, 2)
  /// Display / settlement currency for retail and b2b (always BYN on storefront).
  currency           String            @default("BYN") @db.Char(3)
  quantity           Int               @default(0)
  reservedQuantity   Int               @default(0)
  availabilityStatus OfferAvailability @default(UNKNOWN)
  stockSource        StockSourceKind?
  /// Only confirmed stock may appear as in-stock on the storefront.
  stockConfirmed     Boolean           @default(false)
  stockUpdatedAt     DateTime?         @db.Timestamptz(3)
  leadTime           Int?
  updatedAt          DateTime          @updatedAt @db.Timestamptz(3)
  createdAt          DateTime          @default(now()) @db.Timestamptz(3)
  priceHistory       OfferPriceHistory[]
  orderItems         OrderItem[]

  @@index([productId, availabilityStatus])
  @@index([productId, status])
  @@index([supplierId])
  @@index([warehouseId])
  @@index([supplierId, externalId])
  @@index([stockConfirmed, availabilityStatus])
}

model OfferPriceHistory {
  id               String   @id @default(uuid()) @db.Uuid
  offerId          String   @db.Uuid
  offer            ProductOffer @relation(fields: [offerId], references: [id], onDelete: Cascade)
  purchasePrice    Decimal? @db.Decimal(12, 2)
  purchaseCurrency String?  @db.Char(3)
  fxRate           Decimal? @db.Decimal(18, 8)
  markupType       MarkupType?
  markupValue      Decimal? @db.Decimal(12, 4)
  extrasAmount     Decimal? @db.Decimal(12, 2)
  retailPrice      Decimal? @db.Decimal(12, 2)
  b2bPrice         Decimal? @db.Decimal(12, 2)
  currency         String   @default("BYN") @db.Char(3)
  source           String
  note             String?
  createdAt        DateTime @default(now()) @db.Timestamptz(3)

  @@index([offerId, createdAt])
}

/// Manual FX rates only — no automatic FX without a configured rate/source.
model FxRate {
  id            String   @id @default(uuid()) @db.Uuid
  baseCurrency  String   @db.Char(3)
  quoteCurrency String   @db.Char(3)
  rate          Decimal  @db.Decimal(18, 8)
  source        String
  effectiveFrom DateTime @db.Timestamptz(3)
  effectiveTo   DateTime? @db.Timestamptz(3)
  createdAt     DateTime @default(now()) @db.Timestamptz(3)

  @@index([baseCurrency, quoteCurrency, effectiveFrom])
}

model MarkupRule {
  id          String      @id @default(uuid()) @db.Uuid
  name        String
  scope       MarkupScope
  categoryId  String?     @db.Uuid
  supplierId  String?     @db.Uuid
  supplier    Supplier?   @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  partBrandId String?     @db.Uuid
  markupType  MarkupType
  value       Decimal     @db.Decimal(12, 4)
  b2bValue    Decimal?    @db.Decimal(12, 4)
  priority    Int         @default(100)
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime    @updatedAt @db.Timestamptz(3)

  @@index([scope, isActive, priority])
  @@index([categoryId])
  @@index([supplierId])
  @@index([partBrandId])
}

model ImportTemplate {
  id         String      @id @default(uuid()) @db.Uuid
  supplierId String      @db.Uuid
  supplier   Supplier    @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  name       String
  mapping    Json
  options    Json
  createdAt  DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime    @updatedAt @db.Timestamptz(3)
  jobs       ImportJob[]

  @@unique([supplierId, name])
  @@index([supplierId])
}

model ImportJob {
  id          String          @id @default(uuid()) @db.Uuid
  supplierId  String?         @db.Uuid
  supplier    Supplier?       @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  warehouseId String?         @db.Uuid
  warehouse   Warehouse?      @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  templateId  String?         @db.Uuid
  template    ImportTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  sourceType  OfferSourceType
  filename    String
  status      ImportJobStatus @default(UPLOADED)
  headers     Json
  rawRows     Json
  mapping     Json?
  summary     Json?
  createdAt   DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime        @updatedAt @db.Timestamptz(3)
  rows        ImportRow[]

  @@index([status, createdAt])
  @@index([supplierId])
}

model ImportRow {
  id         String          @id @default(uuid()) @db.Uuid
  jobId      String          @db.Uuid
  job        ImportJob       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  rowNumber  Int
  normalized Json
  action     ImportRowAction
  message    String?
  productId  String?         @db.Uuid
  offerId    String?         @db.Uuid
  snapshot   Json?
  applied    Boolean         @default(false)

  @@unique([jobId, rowNumber])
  @@index([jobId, action])
}

model SupplierSyncLog {
  id           String             @id @default(uuid()) @db.Uuid
  supplierId   String             @db.Uuid
  supplier     Supplier           @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  kind         SupplierSyncKind
  status       SupplierSyncStatus
  attempt      Int                @default(1)
  itemsRead    Int                @default(0)
  itemsWritten Int                @default(0)
  errorMessage String?
  detail       Json?
  startedAt    DateTime           @default(now()) @db.Timestamptz(3)
  finishedAt   DateTime?          @db.Timestamptz(3)

  @@index([supplierId, startedAt])
  @@index([status, startedAt])
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actor      String
  action     String
  entityType String
  entityId   String
  summary    String
  changes    Json?
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  @@index([createdAt])
  @@index([entityType, entityId])
}

model VinRequest {
  id              String              @id @default(uuid()) @db.Uuid
  vin             String
  vinIsStandard   Boolean
  vehicleBrand    String?
  vehicleModel    String?
  vehicleYear     Int?
  engine          String?
  partName        String?
  partNumber      String?
  customerName    String
  phone           String?
  email           String?
  comment         String?
  consentAccepted Boolean
  consentAt       DateTime            @db.Timestamptz(3)
  ip              String?
  status          VinRequestStatus    @default(NEW)
  createdAt       DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime            @updatedAt @db.Timestamptz(3)
  history         VinRequestHistory[]

  @@index([status, createdAt])
  @@index([vin])
}

/// Status / comment trail for VIN leads. No VIN decode payload is stored here.
model VinRequestHistory {
  id           String            @id @default(uuid()) @db.Uuid
  vinRequestId String            @db.Uuid
  vinRequest   VinRequest        @relation(fields: [vinRequestId], references: [id], onDelete: Cascade)
  fromStatus   VinRequestStatus?
  toStatus     VinRequestStatus
  comment      String?
  actor        String
  createdAt    DateTime          @default(now()) @db.Timestamptz(3)

  @@index([vinRequestId, createdAt])
}

model DeliveryMethod {
  id                    String   @id @default(uuid()) @db.Uuid
  code                  String   @unique
  name                  String
  description           String?
  requiresAddress       Boolean  @default(false)
  /// Catalog hint only — checkout does not auto-trust this as final without manager confirm when flagged.
  basePriceCents        Int?
  etaDaysMin            Int?
  etaDaysMax            Int?
  managerConfirmsCost   Boolean  @default(true)
  managerConfirmsEta    Boolean  @default(true)
  isActive              Boolean  @default(true)
  sortOrder             Int      @default(0)
  createdAt             DateTime @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime @updatedAt @db.Timestamptz(3)
  orders                Order[]

  @@index([isActive, sortOrder])
}

model Order {
  id                           String        @id @default(uuid()) @db.Uuid
  number                       String        @unique
  accessToken                  String        @unique
  status                       OrderStatus   @default(NEW)
  paymentState                 PaymentState  @default(NOT_CONNECTED)
  checkoutMode                 CheckoutMode  @default(MANAGER)
  customerName                 String
  customerPhone                String?
  customerEmail                String?
  customerCity                 String?
  comment                      String?
  deliveryMethodId             String?       @db.Uuid
  deliveryMethodRef            DeliveryMethod? @relation(fields: [deliveryMethodId], references: [id], onDelete: Restrict)
  /// Legacy free-text label kept for older rows / display fallback.
  deliveryMethod               String?
  deliveryAddress              String?
  deliveryNote                 String?
  deliveryEtaText              String?
  deliveryCostConfirmedByManager Boolean     @default(false)
  deliveryEtaConfirmedByManager  Boolean     @default(false)
  paymentNote                  String?
  subtotalCents                Int
  discountCents                Int           @default(0)
  deliveryCents                Int           @default(0)
  totalCents                   Int
  currency                     String        @default("BYN") @db.Char(3)
  /// Last-touch UTM at checkout (marketing attribution only — never store customer PII here).
  utmSource                    String?
  utmMedium                    String?
  utmCampaign                  String?
  utmContent                   String?
  utmTerm                      String?
  firstTouchSource             String?
  lastTouchSource              String?
  attributionCapturedAt        DateTime?     @db.Timestamptz(3)
  createdAt                    DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt                    DateTime      @updatedAt @db.Timestamptz(3)
  items                        OrderItem[]
  statusHistory                OrderStatusHistory[]
  paymentTransactions          PaymentTransaction[]

  @@index([status, createdAt])
  @@index([deliveryMethodId])
  @@index([utmSource, createdAt])
  @@index([firstTouchSource, createdAt])
  @@index([lastTouchSource, createdAt])
}

model OrderItem {
  id                String    @id @default(uuid()) @db.Uuid
  orderId           String    @db.Uuid
  order             Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId         String?   @db.Uuid
  product           Product?  @relation(fields: [productId], references: [id], onDelete: SetNull)
  offerId           String?   @db.Uuid
  offer             ProductOffer? @relation(fields: [offerId], references: [id], onDelete: SetNull)
  sku               String
  name              String
  unitPriceCents    Int
  quantity          Int
  currency          String    @default("BYN") @db.Char(3)
  /// Offer.updatedAt captured at checkout for freshness audits.
  offerUpdatedAt    DateTime? @db.Timestamptz(3)
  priceCapturedAt   DateTime  @default(now()) @db.Timestamptz(3)

  @@index([orderId])
  @@index([productId])
  @@index([offerId])
}

model OrderStatusHistory {
  id         String       @id @default(uuid()) @db.Uuid
  orderId    String       @db.Uuid
  order      Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fromStatus OrderStatus?
  toStatus   OrderStatus
  actor      String
  note       String?
  createdAt  DateTime     @default(now()) @db.Timestamptz(3)

  @@index([orderId, createdAt])
}

model PaymentTransaction {
  id              String                   @id @default(uuid()) @db.Uuid
  orderId         String                   @db.Uuid
  order           Order                    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider        String
  externalId      String?
  status          PaymentTransactionStatus @default(CREATED)
  amountCents     Int
  currency        String                   @default("BYN") @db.Char(3)
  idempotencyKey  String                   @unique
  failureReason   String?
  metadata        Json?
  createdAt       DateTime                 @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime                 @updatedAt @db.Timestamptz(3)
  webhooks        PaymentWebhook[]

  @@index([orderId, createdAt])
  @@index([provider, externalId])
  @@index([status])
}

model PaymentWebhook {
  id              String              @id @default(uuid()) @db.Uuid
  provider        String
  eventId         String
  signatureValid  Boolean
  payload         Json
  processed       Boolean             @default(false)
  processError    String?
  transactionId   String?             @db.Uuid
  transaction     PaymentTransaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  createdAt       DateTime            @default(now()) @db.Timestamptz(3)
  processedAt     DateTime?           @db.Timestamptz(3)

  @@unique([provider, eventId])
  @@index([createdAt])
}

/// Leads for rare parts / price requests / B2B — SMTP + Telegram later.
model Lead {
  id        String     @id @default(uuid()) @db.Uuid
  type      LeadType
  status    LeadStatus @default(NEW)
  name      String
  phone     String?
  email     String?
  message   String?
  productId String?    @db.Uuid
  vin       String?
  article   String?
  ip        String?
  /// Last-touch UTM at lead submit (marketing attribution only — never store customer PII here).
  utmSource             String?
  utmMedium             String?
  utmCampaign           String?
  utmContent            String?
  utmTerm               String?
  firstTouchSource      String?
  lastTouchSource       String?
  attributionCapturedAt DateTime? @db.Timestamptz(3)
  createdAt DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt DateTime   @updatedAt @db.Timestamptz(3)

  @@index([type, status, createdAt])
  @@index([utmSource, createdAt])
  @@index([firstTouchSource, createdAt])
  @@index([lastTouchSource, createdAt])
}

model SeoMetadata {
  id            String        @id @default(uuid()) @db.Uuid
  entityType    SeoEntityType
  entityId      String        @db.Uuid
  title         String?
  description   String?
  h1            String?
  canonicalPath String?
  /// Manual SEO body; template alone is not unique content.
  seoText       String?
  robotsMode    SeoRobotsMode @default(AUTO)
  ogImageUrl    String?
  updatedAt     DateTime      @updatedAt @db.Timestamptz(3)

  @@unique([entityType, entityId])
}

/// Keyword cluster storage. Does NOT auto-generate landing pages.
model SemanticCluster {
  id          String                 @id @default(uuid()) @db.Uuid
  slug        String                 @unique
  name        String
  intent      SemanticClusterIntent
  /// Planned or editorial target path — never invent pages from this alone.
  targetPath  String?
  notes       String?
  isActive    Boolean                @default(true)
  createdAt   DateTime               @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime               @updatedAt @db.Timestamptz(3)
  keywords    SemanticClusterKeyword[]

  @@index([intent, isActive])
}

model SemanticClusterKeyword {
  id        String          @id @default(uuid()) @db.Uuid
  clusterId String          @db.Uuid
  cluster   SemanticCluster @relation(fields: [clusterId], references: [id], onDelete: Cascade)
  phrase    String
  locale    String          @default("ru")
  createdAt DateTime        @default(now()) @db.Timestamptz(3)

  @@unique([clusterId, phrase])
  @@index([phrase])
}

/// Analytics / webmaster verification IDs. Env vars override when set.
model SeoSettings {
  id                          String   @id @default(uuid()) @db.Uuid
  /// Master switch for public indexing; also gated by SEO_INDEXING_ENABLED env.
  indexingEnabled             Boolean  @default(false)
  ga4MeasurementId            String?
  gscVerification             String?
  yandexMetrikaId             String?
  yandexWebmasterVerification String?
  googleMerchantId            String?
  updatedAt                   DateTime @updatedAt @db.Timestamptz(3)
  createdAt                   DateTime @default(now()) @db.Timestamptz(3)
}

/// Staff roles for admin panel RBAC (server-enforced). Better Auth may replace sessions later.
enum AdminRole {
  SUPER_ADMIN
  ADMIN
  MANAGER
  WAREHOUSE_MANAGER
  SEO_MANAGER
  B2B_MANAGER
}

model StaffUser {
  id            String        @id @default(uuid()) @db.Uuid
  email         String        @unique
  name          String
  role          AdminRole
  passwordHash  String
  isActive      Boolean       @default(true)
  createdAt     DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime      @updatedAt @db.Timestamptz(3)
  cmsDocuments  CmsDocument[]

  @@index([role, isActive])
}

/// Editorial CMS document. Publish gate required; reviews also need reviewConfirmed.
model CmsDocument {
  id              String        @id @default(uuid()) @db.Uuid
  kind            ContentKind
  status          ContentStatus @default(DRAFT)
  slug            String
  title           String
  excerpt         String?
  /// Plain-text / paragraph body. No auto-generated spam templates.
  body            String
  coverImageUrl   String?
  /// Display author attribution (real editor/staff name — not invented expertise).
  authorName      String?
  authorStaffId   String?       @db.Uuid
  authorStaff     StaffUser?    @relation(fields: [authorStaffId], references: [id], onDelete: SetNull)
  publishedAt     DateTime?     @db.Timestamptz(3)
  /// Reviews stay off the storefront until staff confirms authenticity.
  reviewConfirmed Boolean       @default(false)
  categoryId      String?       @db.Uuid
  category        Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  vehicleBrandId  String?       @db.Uuid
  vehicleBrand    VehicleBrand? @relation(fields: [vehicleBrandId], references: [id], onDelete: SetNull)
  vehicleModelId  String?       @db.Uuid
  vehicleModel    VehicleModel? @relation(fields: [vehicleModelId], references: [id], onDelete: SetNull)
  createdAt       DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime      @updatedAt @db.Timestamptz(3)
  images          CmsDocumentImage[]
  relatedProducts CmsDocumentProduct[]

  @@unique([kind, slug])
  @@index([status, kind, publishedAt])
  @@index([categoryId, status])
  @@index([vehicleBrandId, status])
  @@index([vehicleModelId, status])
}

model CmsDocumentImage {
  id         String      @id @default(uuid()) @db.Uuid
  documentId String      @db.Uuid
  document   CmsDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  url        String
  alt        String?
  sortOrder  Int         @default(0)
  createdAt  DateTime    @default(now()) @db.Timestamptz(3)

  @@index([documentId, sortOrder])
}

model CmsDocumentProduct {
  id         String      @id @default(uuid()) @db.Uuid
  documentId String      @db.Uuid
  document   CmsDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  productId  String      @db.Uuid
  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  sortOrder  Int         @default(0)
  createdAt  DateTime    @default(now()) @db.Timestamptz(3)

  @@unique([documentId, productId])
  @@index([productId])
  @@index([documentId, sortOrder])
}

/// Singleton company profile for admin. Storefront only reads when publishToStorefront=true.
model CompanySettings {
  id                 String   @id @default(uuid()) @db.Uuid
  orgName            String?
  legalName          String?
  unp                String?
  legalAddress       String?
  actualAddress      String?
  phones             String?
  email              String?
  hours              String?
  /// Explicit publish gate — empty/incomplete rows must stay off the storefront.
  publishToStorefront Boolean @default(false)
  updatedAt          DateTime @updatedAt @db.Timestamptz(3)
  createdAt          DateTime @default(now()) @db.Timestamptz(3)
}

/// 301/alias rules applied at request time by the SEO redirect gate.
model RedirectRule {
  id        String   @id @default(uuid()) @db.Uuid
  fromPath  String   @unique
  toPath    String
  isActive  Boolean  @default(true)
  note      String?
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([isActive])
}
